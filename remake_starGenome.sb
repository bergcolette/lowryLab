#!/bin/bash --login
# Job name:
#SBATCH --job-name=make_STARgenome_AP13_DAC_pseudo
#SBATCH --nodes=1
#SBATCH --mem=96GB 
#SBATCH --ntasks-per-node=16
#SBATCH --time=4:00:00
#SBATCH --mail-type=ALL
#SBATCH --mail-user=bergcole@msu.edu
#SBATCH --output=%x-%j.SLURMout

echo "JobID: $SLURM_JOB_ID"
echo "Running on node: `hostname`"

# first purging modules, then loading what you need 
# load in Trimmomatic, bwa, samtools, gatk, picard 
module purge 
module load STAR

# the STAR aligner needs a path to the genome .fasta files and .gtf files
# then STAR creates a specific index for that genome 

genDir="/mnt/scratch/bergcole/ASE/AP13_DAC6_pseudo"

STAR \
    --runThreadN 16 \
    --runMode genomeGenerate \
    --genomeDir ${genDir} \
    --genomeFastaFiles ${genDir}/AP13_DAC6_pseudo.fa \
    --sjdbGTFfile ${genDir}/AP13_DAC6_pseudo.gtf \
    --sjdbOverhang 149 \
