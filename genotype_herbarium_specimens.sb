	-V ${fastqDir}/UMH53.g.vcf.gz \
	-V ${fastqDir}/UMH55.g.vcf.gz \
	-V ${fastqDir}/UMH56.g.vcf.gz \
	-V ${fastqDir}/UMH59.g.vcf.gz \
	-V ${fastqDir}/UMH5.g.vcf.gz \
	-V ${fastqDir}/UMH61.g.vcf.gz \
	-V ${fastqDir}/UMH63.g.vcf.gz \
	-V ${fastqDir}/UMH65.g.vcf.gz \
	-V ${fastqDir}/UMH66.g.vcf.gz \
	-V ${fastqDir}/UMH68.g.vcf.gz \
	-V ${fastqDir}/UMH6.g.vcf.gz \
	-V ${fastqDir}/YH12.g.vcf.gz \
	-V ${fastqDir}/YH14.g.vcf.gz \
	-V ${fastqDir}/YH15.g.vcf.gz \
	-V ${fastqDir}/YH1.g.vcf.gz \
	-V ${fastqDir}/YH2.g.vcf.gz \
	-V ${fastqDir}/YH3.g.vcf.gz \
	-V ${fastqDir}/YH4.g.vcf.gz \
    --genomicsdb-workspace-path ${fastqDir}/switchgrass_herbarium_${sampleID} \
    -L ${sampleID}

gatk --java-options "-Xmx48G -XX:+UseParallelGC -XX:ParallelGCThreads=16" GenotypeGVCFs \
   -R ${genome} \
   -V gendb://${fastqDir}/switchgrass_herbarium_${sampleID} \
   -O ${fastqDir}/switchgrass_herbarium_${sampleID}.vcf.gz
